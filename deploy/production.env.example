# DNS for this domain must point to the Docker host; allow inbound TCP 80/443.
APP_DOMAIN=scholarship.example.edu

# Blank means the browser calls /api on the same HTTPS origin.
VITE_API_BASE_URL=

# Set this to the private URL for your Ollama host; never expose Ollama publicly.
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=180

# Optional bearer token only when a private authenticated proxy protects Ollama.
OLLAMA_API_KEY=

MAX_UPLOAD_BYTES=10485760
AI_SERVICE_TIMEOUT_MS=240000
